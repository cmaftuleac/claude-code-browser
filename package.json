{
  "name": "claude-code-browser",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Corneliu Maftuleac",
    "url": "https://x.com/cmaftuleac"
  },
  "contributors": [
    "Fineguide.AI (https://fineguide.ai)"
  ],
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "chrome": "/Applications/Google\\ Chrome.app/Contents/MacOS/Google\\ Chrome --remote-debugging-port=9222 --user-data-dir=/tmp/chrome-ccb",
    "dev:server": "npm run dev -w apps/server",
    "dev:extension": "npm run dev -w apps/extension",
    "build:extension": "npm run build -w apps/extension",
    "build:server": "npm run build -w apps/server",
    "build:host": "npm run build -w apps/host",
    "dev:host": "npm run dev -w apps/host",
    "dev:desktop": "npm run dev -w apps/desktop",
    "build:desktop": "npm run build -w apps/desktop",
    "dev:web": "npm run build -w packages/shared -w packages/agent-core && concurrently -n server,web -c blue,green \"npm run dev -w apps/server\" \"npm run dev:web -w apps/desktop\"",
    "build:web": "npm run build -w packages/shared -w packages/agent-core && npm run build:web -w apps/desktop && npm run build -w apps/server",
    "start:web": "npm run build:web && node apps/server/dist/index.js",
    "install-host": "npm run build -w apps/host && node apps/host/dist/install.js install",
    "uninstall-host": "node apps/host/dist/install.js uninstall"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
