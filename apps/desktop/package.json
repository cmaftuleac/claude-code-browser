{
  "name": "@fineguide-tesseract/desktop",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Corneliu Maftuleac",
    "url": "https://x.com/cmaftuleac"
  },
  "contributors": [
    "Fineguide.AI (https://fineguide.ai)"
  ],
  "description": "AI-native desktop app — embedded browser + Photoshop-style HTML editor on top of Claude Code.",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir",
    "release": "electron-vite build && electron-builder --config electron-builder.yml --publish always",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fineguide-tesseract/agent-core": "*",
    "@fineguide-tesseract/shared": "*",
    "@fontsource-variable/geist": "^5.1.0",
    "@fontsource-variable/geist-mono": "^5.1.0",
    "@monaco-editor/react": "^4.6.0",
    "@ricky0123/vad-web": "^0.0.30",
    "apache-arrow": "^17.0.0",
    "electron-updater": "^6.3.9",
    "exifreader": "^4.23.0",
    "framer-motion": "^11.11.0",
    "highlight.js": "^11.11.1",
    "hyparquet": "^1.10.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.52.0",
    "music-metadata-browser": "^2.5.10",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "vite": "^6.0.0"
  }
}
