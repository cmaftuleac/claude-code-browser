<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron/V8 JIT under the hardened runtime (required for notarization). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The agent-core vendored binaries (e.g. ripgrep) aren't signed by us; the
       hardened runtime would otherwise refuse to load them under our identity. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Voice mode: microphone capture for the composer's conversation. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
