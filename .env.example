# Copy to .env and adjust. docker compose reads .env automatically.

# Host port the gateway publishes. Use 80 for privileged serving (change the
# compose mapping to "80:8080" too if you want the container side unchanged).
GATEWAY_PORT=8080

# Directory inside the backend that the agent reads/edits. Bind-mounted from
# ./workspace by docker-compose.yml. Repoint by editing the bind mount + this var.
CCB_ROOT=/workspace

# Optional: required only for live agent conversations. File browsing/editing
# works without it; chat fails gracefully until it's set.
ANTHROPIC_API_KEY=

# Drop an idle tenant's in-memory agent manager this many ms after their last
# connection closes (default 30 min = 1800000). Lower it to reclaim sooner.
CCB_MANAGER_REAP_MS=1800000

# ── Headless browser (the `browser` service) ─────────────────────────────────
# Raw Chrome DevTools Protocol endpoint the backend drives for the agent's
# browser tools + the human mirror. Defaults to the compose service.
CCB_BROWSER_CDP_URL=http://browser:9222

# ── WebRTC ICE/TURN (the `coturn` service) ───────────────────────────────────
# The browser mirror streams direct peer-to-peer over WebRTC. STUN alone covers
# most networks; a TURN relay is needed for restrictive NATs. Leave TURN_* blank
# to run STUN-only (the JPEG-over-WS fallback still works regardless).
STUN_URL=stun:stun.l.google.com:19302
# Public TURN URL clients dial (the coturn host). e.g. turn:turn.example.com:3478
TURN_HOST=
# Shared secret for coturn's REST/long-term credential mechanism. Generate: openssl rand -hex 32
TURN_SECRET=
TURN_REALM=ccb

# ── Auth (cloud API: apps/api) ───────────────────────────────────────────────
# Gate the web build behind login. The backend (apps/server) verifies tokens; the
# api (apps/api) issues them. Both MUST share CCB_JWT_SECRET. Off (false) → no gate.
CCB_REQUIRE_AUTH=true
# REQUIRED when auth is on. Generate: openssl rand -hex 32
# This is the SHARED secret across apps/api, apps/server, AND fineguide.ai — all
# three must use the exact same value or every gated request 401s.
CCB_JWT_SECRET=
CCB_JWT_TTL=7d
# Public origin the gateway serves on — used to build the Google OAuth redirect_uri
# (must match the Authorized redirect URI in the Google console). Default = GATEWAY_PORT.
CCB_PUBLIC_URL=http://localhost:8080
# Google OAuth (leave blank to disable the "Continue with Google" button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── fineguide.ai parent platform (federated identity) ─────────────────────────
# Where identity + profile + subscription live. Leave BLANK and apps/api acts as
# the reference/mock implementation of the fineguide.ai contract (local Postgres +
# local Google flow) — the whole login → onboarding → plan flow works end-to-end in
# dev. Set to the real origin (e.g. https://fineguide.ai) to delegate: apps/api then
# forwards /fineguide/* writes there and redirects the hosted login to it. The token
# is signed with the SHARED CCB_JWT_SECRET above.
FINEGUIDE_ORIGIN=
# Renderer build flag: when 'true', the login screen shows a single "Continue with
# fineguide.ai" CTA (no local email/password). Leave unset in dev/self-host so the
# email/password path stays available. (Consumed by Vite as VITE_CCB_FEDERATED.)
VITE_CCB_FEDERATED=

# ── Postgres (the bundled `db` service; data bind-mounted at ./data/postgres) ──
POSTGRES_USER=ccb
POSTGRES_PASSWORD=ccb
POSTGRES_DB=ccb
DATABASE_URL=postgres://ccb:ccb@db:5432/ccb
CCB_API_PORT=9320
